{
	"name": "sga-landing-page",
	"compatibility_date": "2026-05-08",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": [
			"/events/*"
		]
	},
	"main": "worker.js",
	"workers_dev": false,
	"preview_urls": false,
	"keep_vars": true,
	"routes": [
		{
			"pattern": "sga-cakrawala.org",
			"custom_domain": true
		}
	]
}
