# URL deployment AdvocationDashboard, tanpa trailing slash.
# Form student-voice: CMS Hub dulu, fallback backend satgas lama
VITE_CMS_API_URL=https://cms.sga-cakrawala.org/api/v1
VITE_ADVOCATION_API_URL=https://satgas.sga-cakrawala.org

# Satu endpoint data section landing (missions, members, events).
VITE_API_BASE_URL=https://superapp.sga-cakrawala.org/sga-profile/v1/landing

# Slug campaign default untuk tombol /student-voice. Campaign khusus dibuka
# melalui /student-voice/slug-campaign dari tautan atau QR yang diberikan CMS.
# Format lama /student-voice?campaign=slug-campaign tetap didukung.
VITE_STUDENT_VOICE_CAMPAIGN=student-voice